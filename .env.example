# LLM_BACKEND=none      -> rules only
# LLM_BACKEND=ollama    -> open model on this computer (offline, private)
# LLM_BACKEND=backboard -> hosted model through Backboard (public demo)
LLM_BACKEND=backboard
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:1.5b
# Never commit a real key. Use `export` in your shell or the Render dashboard.
BACKBOARD_API_KEY=
BACKBOARD_PROVIDER=openrouter
BACKBOARD_MODEL=moonshotai/kimi-k2.6
MODEL_MAX_PER_HOUR=60
# Owner's private price list (default: api/data/prices.json, which git ignores)
# PRICES_FILE=
